NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL="postgresql://cafe:cafe@localhost:5432/cafe?schema=public"

# Secret used to sign the shared-login JWT. Generate a long random value for production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# Comma-separated list of allowed CORS origins for the frontend dev server.
CORS_ORIGIN="http://localhost:5173"
